# Plantilla de la configuracion de produccion.
#
# En la instancia se copia a `.env`, en esta misma carpeta, y se completan los
# valores. Ese archivo NO va a git: es el unico lugar donde viven las
# contraseñas reales.
#
#   cp .env.example .env && nano .env
#
# Para generar los dos secretos:
#   openssl rand -base64 36

# --- Imagenes -----------------------------------------------------------
# Donde GitHub Actions publica las imagenes ya compiladas. Todo en minuscula.
IMAGE_REPO=ghcr.io/uca-argentina/pid-2026-gepeto
# `latest` sigue siempre al ultimo push a main. Para volver a una version
# anterior, se pone aca el hash del commit que andaba y se levanta de nuevo.
IMAGE_TAG=latest

# --- Dominio ------------------------------------------------------------
# Dejala vacia hasta tener el dominio: Caddy escucha en el puerto 80 y se
# entra por IP, sin HTTPS. Al completarla, el certificado sale solo.
DOMINIO=

# --- Base de datos ------------------------------------------------------
DB_NAME=aparcar_db
DB_USERNAME=aparcar
DB_PASSWORD=

# --- Seguridad ----------------------------------------------------------
# Firma los tokens de sesion. Cadena larga y aleatoria.
JWT_SECRET=
# Firma los codigos QR de las reservas. La aplicacion NO arranca en produccion
# sin esto: con el valor de desarrollo, el codigo de acceso de cualquier
# reserva seria calculable por quien conozca su id.
ACCESO_CODIGO_SECRET=

# Dominios habilitados a llamar a la API desde el navegador, separados por coma.
# Si se deja vacia se arma sola a partir de DOMINIO, que es lo correcto cuando
# el frontend y el backend comparten dominio.
CORS_ALLOWED_ORIGINS=

# --- Cuenta inicial -----------------------------------------------------
# Se usa una sola vez, cuando la base esta vacia. Sin esto no se puede entrar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DOCUMENTO=
ADMIN_NOMBRE=Administrador

# --- Correo (opcional) --------------------------------------------------
# Solo para recuperar contraseña. Vacias, el resto del sistema anda igual.
# La contraseña es una "contraseña de aplicacion" de Google, no la de la cuenta.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Zona horaria -------------------------------------------------------
TZ=America/Argentina/Buenos_Aires

# --- Memoria ------------------------------------------------------------
# Techo del contenedor del backend. 1200M va bien en una instancia de 2 GB
# (t3.small). Con 4 GB (t3.medium) se puede subir a 2500M.
BACKEND_MEM=1200M
