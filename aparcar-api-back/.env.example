# Server Configuration
DB_USERNAME=admin
DB_PASSWORD=admin
DB_URL=jdbc:postgresql://db:5432/aparcar_db?&serverTimezone=UTC
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_PROFILES_ACTIVE=dev

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email@gmail.com
MAIL_PASSWORD=1234 5678 9101 1121

# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=aparcar_db

# Control de acceso por codigo/QR
# Secreto del HMAC que deriva los codigos de acceso de las reservas. En
# desarrollo se puede dejar comentado (se usa uno fijo, solo para dev); con el
# perfil prod es obligatorio y la app no arranca sin el. Generalo con:
#   openssl rand -base64 32
# ACCESO_CODIGO_SECRET=

# Solo desarrollo: origenes extra permitidos por CORS, separados por coma, para
# probar el front desde el celular (IP local de tu maquina o un tunel HTTPS).
# Ejemplo: CORS_ORIGENES_EXTRA=http://192.168.0.10:3000,https://*.trycloudflare.com
CORS_ORIGENES_EXTRA=
